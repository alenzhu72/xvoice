<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <RootNamespace>VoiceChange</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationId>com.voicechange.studio.gpuclient</ApplicationId>
    <ApplicationVersion>3</ApplicationVersion>
    <ApplicationDisplayVersion>1.2</ApplicationDisplayVersion>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
    <RunAOTCompilation>false</RunAOTCompilation>
    <PublishTrimmed>false</PublishTrimmed>
    <AndroidEnableMarshalMethods>false</AndroidEnableMarshalMethods>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../RvcLan/GpuConnection.cs" />

    <AndroidResource Include="../Resources/drawable-nodpi/voice_logo.png" Link="Resources/drawable-nodpi/voice_logo.png" />
  </ItemGroup>
</Project>




