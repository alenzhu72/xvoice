<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <RootNamespace>VoiceChange</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationId>com.voicechange.studio</ApplicationId>
    <ApplicationVersion>4</ApplicationVersion>
    <ApplicationDisplayVersion>1.3</ApplicationDisplayVersion>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <RuntimeIdentifiers>android-arm64;android-arm;android-x64</RuntimeIdentifiers>
    <RunAOTCompilation>false</RunAOTCompilation>
    <PublishTrimmed>false</PublishTrimmed>
    <!-- Use runtime JNI registration so launch callbacks resolve consistently across APK builds. -->
    <AndroidEnableMarshalMethods>false</AndroidEnableMarshalMethods>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Local/**/*.cs" />
    <Compile Include="../DomesticSpeech.cs;../MiniMaxSpeech.cs;../SpeechSocket.cs;../LiveVoice.cs;../StreamingPhrase.cs;../VoicePreset.cs" />
    <EmbeddedResource Include="obj/speech-config.txt" LogicalName="VoiceChange.AndroidSpeechConfig" />
  </ItemGroup>
</Project>
