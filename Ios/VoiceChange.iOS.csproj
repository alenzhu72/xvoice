<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <MtouchLink>SdkOnly</MtouchLink>
    <SpeechConfigFile Condition="'$(SpeechConfigFile)' == ''">../Android/obj/speech-config.txt</SpeechConfigFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../DomesticSpeech.cs;../MiniMaxSpeech.cs;../SpeechSocket.cs;../LiveVoice.cs;../StreamingPhrase.cs;../VoicePreset.cs" />
    <EmbeddedResource Include="$(SpeechConfigFile)" LogicalName="VoiceChange.IosSpeechConfig" />
    <BundleResource Include="../Android/Resources/drawable-nodpi/voice_logo.png" Link="voice_logo.png" />
    <ImageAsset Include="Assets.xcassets/**/*" />
  </ItemGroup>
</Project>
